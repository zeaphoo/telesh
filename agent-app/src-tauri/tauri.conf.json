{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "telesh agent",
  "mainBinaryName": "telesh-app",
  "version": "0.1.0",
  "identifier": "com.telesh.agent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "telesh agent",
    "longDescription": "telesh agent 的桌面外壳:托盘常驻,窗口直接指向本机面板 127.0.0.1:16345。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/telesh"]
  }
}
