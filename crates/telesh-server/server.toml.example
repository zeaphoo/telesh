# telesh-server 配置示例。用法:
#
#     telesh-server /etc/telesh/server.toml
#
# 命令行只有这一个参数。下面每个字段都可以省略,省略即用注释里写的默认值。

# 数据根目录:数据库、ACME 证书缓存等都放这里。默认 ~/.telesh。
dataroot = "/var/lib/telesh"

# agent 连控制面的地址;同一个端口也提供 dashboard(`/`、`/api/*`、`/metrics`)。
# 默认 0.0.0.0:9009。
control_addr = "0.0.0.0:9009"

# 边缘入口:公网 HTTP / TCP 从这里进来。默认 0.0.0.0:8080。
ingress_addr = "0.0.0.0:8080"

# 数据面:agent 主动连这里。默认 0.0.0.0:9008。
data_addr = "0.0.0.0:9008"

# 拼隧道 URL 用的公网后缀。默认空。
public_host = "example.com"

# 认证:所有控制连接(agent 和 peer)都用密钥对挑战-应答,或者本地缓存的
# session;新公钥第一次登录就建账号(TOFU)。这里没有任何共享密钥要配。
# 更严的注册策略(匿名/邀请/OIDC 等)以后再加。

# TCP 隧道的端口范围。默认 "18000-18100"。
tcp_port_range = "18000-18100"

[relay]
# 跑一个进程内的 iroh 中继。默认不跑。
# serve = "0.0.0.0:8081"

# 通告给 agent 的公网中继 URL。默认由 ACME 域名或 public_host 推导。
# url = "https://relay.example.com"

# 手动 TLS(HTTPS + QUIC 地址发现):
# tls_cert   = "/etc/telesh/relay.crt"
# tls_key    = "/etc/telesh/relay.key"
# https_addr = "0.0.0.0:443"
# quic_addr  = "0.0.0.0:7842"

# ……或者 ACME/Let's Encrypt(优先于手动 TLS):
# acme         = ["relay.example.com"]
# acme_email   = "admin@example.com"
# acme_staging = false
# acme_cache   = "/var/lib/telesh/acme"
